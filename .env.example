# ── Tifl configuration ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# REQUIRED — the app will not start without it.
# Signs bearer tokens; anyone who knows this value can forge tokens.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TIFL_SECRET_KEY=

# Database (defaults to SQLite for local dev).
# TIFL_DATABASE_URL=sqlite:///./tifl.db

# Whisper model size for speech answers (default: small).
# TIFL_WHISPER_MODEL_SIZE=small

# Force stub speech mode (no model download, used by tests).
# TIFL_SPEECH_STUB=0
